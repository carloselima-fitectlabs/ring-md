[Desktop Entry]
Type=Application
Name=RingMD
GenericName=Markdown Editor
Comment=Edit Markdown with Neovim and a live preview
Exec=ringmd %f
Icon=io.github.ringmd.RingMD
Terminal=false
Categories=Utility;TextEditor;
Keywords=markdown;md;neovim;vim;editor;preview;pdf;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=io.github.ringmd.RingMD
